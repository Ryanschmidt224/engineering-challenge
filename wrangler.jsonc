{
  "name": "engineering-challenge",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "building-schmidt-photos"
    }
  ],
  "triggers": {
    "crons": [
      "0 7 * * SUN"
    ]
  },
  "previews": {
    "r2_buckets": [
      {
        "binding": "PHOTOS",
        "bucket_name": "building-schmidt-photos-preview"
      }
    ],
    // Branch previews use their own empty database, never the production Workshop.
    "d1_databases": [
      {
        "binding": "WORKSHOP_DB",
        "database_name": "building-schmidt-workshop-preview",
        "database_id": "3314f42f-7c04-4798-99dc-b5b97c4fb82f"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "WORKSHOP_DB",
      "database_name": "building-schmidt-workshop"
    }
  ]
}
