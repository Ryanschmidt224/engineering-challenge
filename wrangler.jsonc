{
  "name": "engineering-challenge",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/project-engine-proof*",
      "/project",
      "/project/",
      "/project.html"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "building-schmidt-photos"
    }
  ],
  "triggers": {
    "crons": [
      "0 7 * * SUN"
    ]
  },
  "previews": {
    "r2_buckets": [
      {
        "binding": "PHOTOS",
        "bucket_name": "building-schmidt-photos-preview"
      }
    ],
    "d1_databases": [
      {
        "binding": "WORKSHOP_DB",
        "database_name": "building-schmidt-project-restore-preview"
      }
    ],
    "vars": {
      "NEW_PROJECT_ENGINE": "1"
    }
  },
  "d1_databases": [
    {
      "binding": "WORKSHOP_DB",
      "database_name": "building-schmidt-workshop"
    }
  ]
}
