{
  "name": "engineering-challenge",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "building-schmidt-photos"
    }
  ],
  "triggers": {
    "crons": [
      "0 7 * * SUN"
    ]
  },
  "previews": {
    "r2_buckets": [
      {
        "binding": "PHOTOS",
        "bucket_name": "building-schmidt-photos-preview"
      }
    ]
  }
}
