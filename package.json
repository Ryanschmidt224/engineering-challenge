{
  "name": "building-schmidt",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && npm run check:css && node --test tests/*.test.mjs",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "dev": "node scripts/test-server.mjs",
    "format:css": "prettier --write \"assets/*.css\"",
    "check:css": "prettier --check \"assets/*.css\" && node scripts/check-css.mjs && node scripts/prune-retired-css.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  }
}
